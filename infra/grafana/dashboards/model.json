  "panels": [
    {
      "id": 1,
      "title": "Dataset drift share (ALERT at 0.30)",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "fairxai-pg"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "fairxai-pg"
          },
          "rawSql": "SELECT window_end AS time, value AS drift_share FROM monitoring_results WHERE kind='feature_drift' AND value IS NOT NULL AND $__timeFilter(window_end) ORDER BY 1",
          "format": "time_series",
          "editorMode": "code",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 2,
      "title": "PR-AUC on labelled windows vs reference",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "fairxai-pg"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "fairxai-pg"
          },
          "rawSql": "SELECT window_end AS time, value AS pr_auc, (details->>'reference_pr_auc')::float AS reference FROM monitoring_results WHERE kind='performance' AND value IS NOT NULL AND $__timeFilter(window_end) ORDER BY 1",
